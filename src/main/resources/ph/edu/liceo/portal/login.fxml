<?xml version="1.0" encoding="UTF-8"?>

<!--
    login.fxml  -  the LOGIN screen.  Follow Wireframe 1 in the handout.

    TODO 7: give the TextField and the PasswordField their fx:id, and give
            the last Label its fx:id. The names must match the fields you
            declare in LoginController (TODO 9) exactly - JavaFX matches
            them by name, and a typo fails silently.

    TODO 8: make the Button call the controller by adding
            onAction="#handleLogin"
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ph.edu.liceo.portal.controller.LoginController"
      alignment="CENTER" spacing="12" styleClass="login-root">

    <padding><Insets top="30" right="34" bottom="30" left="34"/></padding>

    <Label text="LICEO DE CAGAYAN UNIVERSITY" styleClass="brand"/>
    <Label text="Student Portal" styleClass="title"/>

    <Separator/>

    <Label text="Student Number" styleClass="field-label"/>
    <!-- TODO 7a: add  fx:id="studentNoField"  to the line below -->
    <TextField promptText="2026-00123"/>

    <Label text="Password" styleClass="field-label"/>
    <!-- TODO 7b: add  fx:id="passwordField"  to the line below -->
    <PasswordField promptText="Enter your password"/>

    <!-- TODO 8: add  onAction="#handleLogin"  to the line below -->
    <Button text="LOG IN" maxWidth="Infinity" styleClass="primary"/>

    <!-- TODO 7c: add  fx:id="messageLabel"  to the line below -->
    <Label styleClass="message" wrapText="true"/>
</VBox>
