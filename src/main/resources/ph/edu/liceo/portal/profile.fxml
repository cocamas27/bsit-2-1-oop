<?xml version="1.0" encoding="UTF-8"?>

<!--
    profile.fxml  -  the PROFILE screen.  Follow Wireframe 2 in the handout.

    TODO 11: add the five fx:id attributes marked below. They must match the
             @FXML fields already declared in ProfileController:
             initialsLabel, nameLabel, studentNoLabel, courseLabel, emailLabel.

    The LOG OUT button is already wired for you.
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.liceo.portal.controller.ProfileController"
            styleClass="profile-root">

    <top>
        <VBox alignment="CENTER" spacing="8" styleClass="header">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="STUDENT PROFILE" styleClass="header-text"/>
            <!-- TODO 11a: add  fx:id="initialsLabel" -->
            <Label text="--" styleClass="avatar"/>
            <!-- TODO 11b: add  fx:id="nameLabel" -->
            <Label text="Student Name" styleClass="header-name"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="14" vgap="14" styleClass="details">
            <padding><Insets top="24" right="26" bottom="10" left="26"/></padding>

            <Label text="Student No.:" styleClass="field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <!-- TODO 11c: add  fx:id="studentNoLabel" -->
            <Label text="-" styleClass="value"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Course:" styleClass="field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <!-- TODO 11d: add  fx:id="courseLabel" -->
            <Label text="-" styleClass="value" wrapText="true"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Email:" styleClass="field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <!-- TODO 11e: add  fx:id="emailLabel" -->
            <Label text="-" styleClass="value"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding><Insets top="10" right="26" bottom="24" left="26"/></padding>
            <Button text="LOG OUT" onAction="#handleLogout" maxWidth="Infinity" styleClass="primary"/>
        </VBox>
    </bottom>
</BorderPane>
