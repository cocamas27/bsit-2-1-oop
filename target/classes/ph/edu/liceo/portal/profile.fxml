<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.liceo.portal.controller.ProfileController"
            styleClass="profile-root">

    <top>
        <VBox alignment="CENTER" spacing="8" styleClass="profile-header">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- 1. Initials Label -->
            <Label fx:id="initialsLabel" styleClass="avatar"/>

            <!-- 2. Full Name Label -->
            <Label fx:id="nameLabel" styleClass="profile-name"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="12" vgap="12" alignment="CENTER">
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

            <Label text="Student No:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="field-label"/>
            <!-- 3. Student Number Label -->
            <Label fx:id="studentNoLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Course &amp; Year:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="field-label"/>
            <!-- 4. Course Label -->
            <Label fx:id="courseLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="field-label"/>
            <!-- 5. Email Label -->
            <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>
            <Button text="LOG OUT" onAction="#handleLogout" styleClass="secondary"/>
        </HBox>
    </bottom>

</BorderPane>